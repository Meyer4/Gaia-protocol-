# ---------------------------------------------------------------------------
# Gaia Protocol — server configuration
# Copy to `.env` and fill in what you need. Everything here is optional:
# the node runs with real telemetry, real proof of work, real ZK proofs and
# the live USGS feed without any keys.
# ---------------------------------------------------------------------------

# Google Gemini API key (https://aistudio.google.com/apikey)
# Enables the assistant and the outreach studio. Kept on the server only —
# it is never injected into the browser bundle.
GEMINI_API_KEY=""

# Comma-separated model candidates, tried in order. The first one that
# actually answers is remembered and reported to the UI.
# Default: gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-2.5-flash
GEMINI_MODEL=""

# Where the node listens.
PORT="3000"
HOST="0.0.0.0"

# SQLite database location (created if missing).
# GAIA_DATA_DIR="./data"
# GAIA_DB_PATH="./data/gaia.db"

# Directories the in-app file browser may read, separated by the platform
# path delimiter (":" on POSIX, ";" on Windows). Dotfiles, .git, node_modules
# and database files are refused inside them.
# GAIA_BROWSE_ROOTS="/absolute/path/to/repo"
